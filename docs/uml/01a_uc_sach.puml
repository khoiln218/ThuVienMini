@startuml
skinparam defaultFontName Arial
skinparam shadowing false
skinparam packageStyle rectangle
left to right direction
actor "Thủ thư" as T
actor "Quản trị viên" as A
T <|-- A
rectangle "Quản lý sách" {
  usecase "UC02 Thêm sách" as UC02
  usecase "UC03 Sửa sách" as UC03
  usecase "UC04 Tìm kiếm sách" as UC04
  usecase "UC05 Lưu trữ sách" as UC05
}
T -- UC02
T -- UC03
T -- UC04
A -- UC05
UC03 ..> UC04 : <<include>>
UC05 ..> UC04 : <<include>>
@enduml
