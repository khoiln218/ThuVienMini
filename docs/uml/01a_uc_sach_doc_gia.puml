@startuml
skinparam defaultFontName Arial
skinparam shadowing false
skinparam packageStyle rectangle
left to right direction
actor "Thủ thư" as T
actor "Quản trị viên" as A
T <|-- A
rectangle "Quản lý sách" {
  usecase "UC04 Thêm sách" as UC04
  usecase "UC05 Sửa sách" as UC05
  usecase "UC06 Tìm kiếm sách" as UC06
  usecase "UC07 Lưu trữ sách" as UC07
}
rectangle "Quản lý độc giả" {
  usecase "UC08 Thêm độc giả" as UC08
  usecase "UC09 Sửa độc giả" as UC09
  usecase "UC10 Tìm kiếm độc giả" as UC10
  usecase "UC11 Lưu trữ độc giả" as UC11
}
T -- UC04
T -- UC05
T -- UC06
T -- UC08
T -- UC09
T -- UC10
A -- UC07
A -- UC11
UC05 ..> UC06 : <<include>>
UC07 ..> UC06 : <<include>>
UC09 ..> UC10 : <<include>>
UC11 ..> UC10 : <<include>>
@enduml
