@startuml
skinparam defaultFontName Arial
skinparam shadowing false
skinparam packageStyle rectangle
left to right direction
actor "Thủ thư" as T
actor "Quản trị viên" as A
T <|-- A
rectangle "Tài khoản cá nhân" {
  usecase "UC01 Đăng nhập" as UC01
  usecase "UC02 Đăng xuất" as UC02
  usecase "UC03 Đổi mật khẩu" as UC03
}
rectangle "Quản trị hệ thống" {
  usecase "UC18 Thêm tài khoản nhân viên" as UC18
  usecase "UC19 Sửa tài khoản nhân viên" as UC19
  usecase "UC20 Ngừng / kích hoạt tài khoản" as UC20
  usecase "UC21 Sao lưu dữ liệu" as UC21
}
T -- UC01
T -- UC02
T -- UC03
A -- UC18
A -- UC19
A -- UC20
A -- UC21
@enduml
