@startuml
skinparam defaultFontName Arial
skinparam shadowing false
package "Backend (app/)" {
class Main <<module>> {
 +current_user(request): dict
 +admin(user): dict
 +login / logout / change_password
 +users / add_user / edit_user
 +books / readers (q, page, size)
 +save_record(table, data, record_id): dict
 +archive(resource, record_id)
 +loans (status, page, size) / loan_detail(id)
 +attach_items(loans): list
 +borrow / return_books / extend_loan
 +export_csv(resource) / make_backup()
 +stats(): dict
}
class LoanService {
 {static} +borrow(data: Borrow, user_id: int): dict
 {static} +return_books(loan_id: int, item_ids: list, user_id: int): dict
 {static} +extend(loan_id: int, days: int): dict
}
class Security <<module>> {
 +hash_password / verify_password
 +make_token / parse_token
 +password_fingerprint
 +LoginGuard (5 lần sai / 15 phút)
}
class DB <<module>> {
 +connect(): Connection
 +transaction(): contextmanager
 +initialize(): None  (schema + migration)
 +query(sql, params): list
 +backup(keep=10): Path
}
class Input {
 str_strip_whitespace = true
 extra = forbid
}
class Book {
 code: str[1..30]
 barcode: str[0..20]
 title: str[1..200]
 author: str[1..100]
 category: str[1..60]
 total: int[0..999]
}
class Reader {
 code: str[1..30]
 name: str[1..100]
 phone: str[0..20]
}
class Borrow {
 reader_id: int > 0
 book_ids: list[int > 0] (1..5)
 days: int[1..30]
}
class Return {
 item_ids: list[int > 0] | None
}
class Extend {
 days: int[1..30]
}
class "Login / PasswordChange\nUserCreate / UserUpdate" as Auth
Input <|-- Book
Input <|-- Reader
Input <|-- Borrow
Input <|-- Return
Input <|-- Extend
Input <|-- Auth
Main ..> LoanService
Main ..> Security
Main ..> Input
Main ..> DB
LoanService ..> DB
}
package "Frontend (app/static/js, ES modules)" {
class "main.js" as FM <<entry>>
class "router.js" as FR
class "pages/*.js + views/*.html" as FP
class "api.js" as FA
class "dom.js" as FD
class "state.js" as FS
FM ..> FR
FM ..> FP
FR ..> FP
FP ..> FA
FP ..> FD
FP ..> FS
}
FA ..> Main : fetch /api/*
@enduml
