@startuml
skinparam defaultFontName Arial
skinparam shadowing false
entity books {
 *id : INTEGER <<PK>>
 --
 code : TEXT <<UQ>>
 barcode : TEXT <<UQ khi khác rỗng>>
 title : TEXT
 author : TEXT
 category : TEXT
 total : INTEGER
 active : INTEGER
}
entity readers {
 *id : INTEGER <<PK>>
 --
 code : TEXT <<UQ>>
 name : TEXT
 phone : TEXT
 active : INTEGER
}
entity loans {
 *id : INTEGER <<PK>>
 --
 book_id : INTEGER <<FK>>
 reader_id : INTEGER <<FK>>
 created_by : INTEGER <<FK>>
 returned_by : INTEGER <<FK nullable>>
 borrowed_on : TEXT
 due_on : TEXT
 returned_on : TEXT nullable
 extensions : INTEGER 0..1
}
entity users {
 *id : INTEGER <<PK>>
 --
 username : TEXT <<UQ>>
 password_hash : TEXT
 role : TEXT
 active : INTEGER
}
books ||--o{ loans
readers ||--o{ loans
users ||--o{ loans : created_by
users |o--o{ loans : returned_by
note bottom of users
 Phiên đăng nhập là token ký HMAC
 trong cookie, không lưu bảng.
 Bảng sessions cũ chỉ giữ để
 tương thích CSDL trước.
end note
@enduml
