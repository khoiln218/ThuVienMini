@startuml
skinparam defaultFontName Arial
skinparam shadowing false
skinparam linetype ortho
hide circle
entity "users\n(Người dùng)" as users {
 * id : INTEGER <<PK>>
 --
 * username : TEXT <<UNIQUE>>
 * password_hash : TEXT
 * full_name : TEXT
 email : TEXT
 phone : TEXT
 * role : TEXT
 * active : INTEGER
}
entity "readers\n(Độc giả)" as readers {
 * id : INTEGER <<PK>>
 --
 * code : TEXT <<UNIQUE>>
 * name : TEXT
 phone : TEXT
 * active : INTEGER
}
entity "books\n(Sách)" as books {
 * id : INTEGER <<PK>>
 --
 * code : TEXT <<UNIQUE>>
 barcode : TEXT <<UNIQUE khi có>>
 * title : TEXT
 * author : TEXT
 * category : TEXT
 * total : INTEGER
 * active : INTEGER
}
entity "loans\n(Phiếu mượn)" as loans {
 * id : INTEGER <<PK>>
 --
 * reader_id : INTEGER <<FK>>
 * created_by : INTEGER <<FK>>
 * borrowed_on : TEXT
 * due_on : TEXT
 * extensions : INTEGER
}
entity "loan_items\n(Chi tiết phiếu mượn)" as items {
 * id : INTEGER <<PK>>
 --
 * loan_id : INTEGER <<FK>>
 * book_id : INTEGER <<FK>>
 returned_on : TEXT
 returned_by : INTEGER <<FK>>
 ..
 UNIQUE(loan_id, book_id)
}
readers ||--o{ loans : mượn
users ||--o{ loans : lập
loans ||--|{ items : gồm
books ||--o{ items : là bản của
users |o--o{ items : nhận trả
@enduml
