@startuml
skinparam defaultFontName Arial
skinparam shadowing false
skinparam linetype ortho
hide circle
entity "users\n(Người dùng)" as users {
 * id : số <<mã số>>
 --
 * username : chuỗi <<không trùng>>
 * password_hash : chuỗi
 * full_name : chuỗi
 email : chuỗi
 phone : chuỗi
 * role : chuỗi
 * active : có/không
}
entity "readers\n(Độc giả)" as readers {
 * id : số <<mã số>>
 --
 * code : chuỗi <<không trùng>>
 * name : chuỗi
 phone : chuỗi
 * active : có/không
}
entity "books\n(Sách)" as books {
 * id : số <<mã số>>
 --
 * code : chuỗi <<không trùng>>
 barcode : chuỗi <<không trùng nếu có>>
 * title : chuỗi
 * author : chuỗi
 * category : chuỗi
 * total : số
 * active : có/không
}
entity "loans\n(Phiếu mượn)" as loans {
 * id : số <<mã số>>
 --
 * reader_id : số <<tham chiếu>>
 * created_by : số <<tham chiếu>>
 * borrowed_on : ngày
 * due_on : ngày
 * extensions : số
}
entity "loan_items\n(Chi tiết phiếu mượn)" as items {
 * id : số <<mã số>>
 --
 * loan_id : số <<tham chiếu>>
 * book_id : số <<tham chiếu>>
 returned_on : ngày
 returned_by : số <<tham chiếu>>
 ..
 mỗi sách một lần trên phiếu
}
readers ||--o{ loans : mượn
users ||--o{ loans : lập
loans ||--|{ items : gồm
books ||--o{ items : là bản của
users |o--o{ items : nhận trả
@enduml
