@startuml
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ActivityBackgroundColor #FFFFFF
skinparam SwimlaneTitleFontStyle bold
|Quản trị viên|
start
:Bấm "Lưu trữ" trên dòng độc giả;
|Hệ thống|
:Hỏi xác nhận lưu trữ;
|Quản trị viên|
if (Đồng ý?) then (không)
  stop
endif
|Hệ thống|
if (Độc giả còn giữ sách chưa trả?) then (có)
  :Hiển thị "Còn sách chưa trả, không thể lưu trữ";
  stop
endif
:Đánh dấu độc giả đã lưu trữ\n(giữ nguyên lịch sử phiếu mượn);
:Hiển thị "Đã lưu trữ", độc giả rời danh sách;
|Quản trị viên|
stop
@enduml
